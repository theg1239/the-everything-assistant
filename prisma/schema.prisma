generator client {
  provider = "prisma-client"
  previewFeatures = ["relationJoins"]
  output   = "./generated"
}

datasource db {
  provider = "cockroachdb"
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  preferences   Json?     @default("{}")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt
  
  mfaEnabled     Boolean   @default(false)
  mfaMethod      String?
  mfaSecret      String?
  backupCodes    String[]  @default([])
  tempMfaSecret  String?
  tempMfaMethod  String?
  tempMfaExpires DateTime?
  
  accounts    Account[]
  sessions    Session[]
  chats       Chat[]
  securityLogs SecurityLog[]
  memories     Memory[]
  memorySettings MemorySettings?
  webAuthnCredentials WebAuthnCredential[]
  whatsappConversations WhatsAppConversation[]
  vtopSnapshots VTOPSnapshot[]
  shares ChatShare[]

  @@index([email])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Chat {
  id         String   @id @default(cuid())
  userId     String
  title      String
  path       String
  archived   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]
  canvas_documents  CanvasDocument[]
  votes             Vote[]
  streamIds         StreamId[]
  shares            ChatShare[]

  @@index([userId, archived, updated_at(sort: Desc)])
  @@index([userId, updated_at(sort: Desc)])
  @@index([archived])
  @@map("chats")
}

model ChatShare {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  title     String?
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId, revoked])
  @@index([userId, createdAt(sort: Desc)])
  @@map("chat_shares")
}

model Message {
  id              String   @id @default(cuid())
  chatId          String
  role            String
  content         String
  tool_invocations Json?
  attachments     Json?
  created_at      DateTime @default(now())
  
  chat  Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([chatId, created_at])
  @@index([chatId, role, created_at(sort: Desc)])
  @@map("messages")
}

model CanvasDocument {
  id         String   @id @default(cuid())
  chatId     String
  title      String
  content    String
  type       String
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, created_at(sort: Desc)])
  @@map("canvas_documents")
}

model Vote {
  chatId     String
  messageId  String
  is_upvoted Boolean
  
  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([chatId, messageId])
  @@map("votes")
}

model SecurityLog {
  id         String   @id @default(cuid())
  userId     String
  event      String
  method     String?
  ipAddress  String?
  userAgent  String?
  created_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, created_at(sort: Desc)])
  @@map("security_logs")
}

model Migration {
  id          Int      @id @default(sequence())
  name        String   @unique
  executed_at DateTime @default(now())

  @@map("migrations")
}

model Memory {
  id          String   @id @default(cuid())
  userId      String
  content     String
  tags        String[] @default([])
  importance  Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, importance, lastUsedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("memories")
}

model MemorySettings {
  id              String   @id @default(cuid())
  userId         String   @unique
  isEnabled      Boolean  @default(true)
  maxTokens      Int      @default(2000)
  autoSave       Boolean  @default(true)
  autoSaveFilter String   @default("medium")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("memory_settings")
}

model StreamId {
  id        String   @id @default(cuid())
  streamId  String   @unique
  chatId    String
  createdAt DateTime @default(now())
  
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  @@index([chatId, createdAt])
  @@map("stream_ids")
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt
  transports   String[] @default([])
  name         String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("webauthn_credentials")
}

model Broadcast {
  id        String   @id @default(cuid())
  slides    Json
  createdAt DateTime @default(now())

  @@map("broadcasts")
}

model TokenUsage {
  id               String   @id @default(cuid())
  userId           String?
  chatId           String?
  model            String?
  stepIndex        Int?
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  meta             Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([model])
  @@map("token_usage")
}

model WhatsAppConversation {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  userName    String?
  userId      String?
  isActive    Boolean  @default(true)
  lastMessageAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    WhatsAppMessage[]
  
  @@index([phoneNumber])
  @@index([userId])
  @@index([lastMessageAt(sort: Desc)])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  conversationId String
  messageId      String   @unique
  direction      String
  content        String
  messageType    String   @default("text")
  status         String   @default("sent")
  isCommand      Boolean  @default(false)
  command        String?
  aiResponse     String?
  processingTimeMs Int?
  createdAt      DateTime @default(now())
  
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([direction, createdAt])
  @@index([isCommand, createdAt])
  @@map("whatsapp_messages")
}

model VTOPSnapshot {
  id        String   @id @default(cuid())
  userId    String
  command   String
  data      Json
  fetchedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, command])
  @@index([userId, fetchedAt(sort: Desc)])
  @@map("vtop_snapshots")
}

enum crdb_internal_region {
  aws_ap_south_1 @map("aws-ap-south-1")
}
