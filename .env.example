###########################################################
# Core App URLs & Runtime                                  #
###########################################################
NODE_ENV=development
NEXT_RUNTIME=nodejs
NEXT_DEV_WRANGLER_ENV=dev
PORT=3000
APP_URL=http://localhost:3000
MAIN_APP_URL=http://localhost:3000
CHAT_API_URL=http://localhost:3000/api/chat
BRIEFING_APP_URL=http://localhost:3000/briefing
RESEND_BRIEFING_APP_URL=http://localhost:3000/api/briefing
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
HUB_CAPABILITIES_PATH=hub-capabilities.json
MAIN_APP_API_KEY=local-main-api-key

###########################################################
# Database & Persistence                                   #
###########################################################
DATABASE_URL="postgresql://username:password@host:5432/app?sslmode=require"
DATABASE_URL2="postgresql://username:password@host:5432/app?sslmode=require"
CRDB_SCHEMA=public
PRISMA_SCHEMA=prisma/schema.prisma

###########################################################
# Authentication, Sessions & Security                      #
###########################################################
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-nextauth-secret
AUTH_SECRET=replace-with-auth-secret
SESSION_SECRET=replace-with-session-secret
SESSION_COOKIE=next-auth.session-token
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_SITE_VERIFICATION=verification-token
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
BOT_OWNER_ID=1234567890
DISABLE_BOTID=false

###########################################################
# AI Providers & Tooling                                   #
###########################################################
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key
GOOGLE_GENERATIVE_AI_API_KEY_2=optional-secondary-key
GOOGLE_GENERATIVE_AI_API_KEY_3=optional-tertiary-key
GOOGLE_AI_API_KEYS=key1,key2,key3
GROQ_API_KEY=your-groq-key
GROQ_API_KEYS=key1,key2
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_API_KEYS=key1,key2
CEREBRAS_API_KEY=your-cerebras-key
CEREBRAS_API_KEYS=key1,key2
EXAMCOOKER_API_KEY=your-examcooker-key
IMAGE_ANALYSIS_ENABLED=true
VIDEO_ANALYSIS_ENABLED=false
MAX_CONTEXT_LENGTH=32000

###########################################################
# Rate Limiting, Retries & Key Rotation                    #
###########################################################
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
API_RATE_LIMIT_REQUESTS_PER_HOUR=1000
API_RATE_LIMIT_REQUESTS_PER_DAY=50000
USER_RATE_LIMIT_REQUESTS_PER_MINUTE=10
USER_RATE_LIMIT_REQUESTS_PER_HOUR=100
USER_RATE_LIMIT_REQUESTS_PER_DAY=1000
USER_RATE_LIMITING_ENABLED=true
GLOBAL_RATE_LIMIT=50000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ADMIN_EMAIL=your-admin-email@example.com
API_RETRY_MAX_RETRIES=3
API_RETRY_BACKOFF_MULTIPLIER=2
API_RETRY_MAX_BACKOFF_MS=30000
API_KEY_ROTATION_ENABLED=true
API_KEY_ROTATE_ON_RATE_LIMIT=true
API_KEY_HEALTH_CHECK_INTERVAL_MS=30000

###########################################################
# Redis / State Stores                                     #
###########################################################
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

###########################################################
# Observability & Monitoring                               #
###########################################################
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=ph_xxxxx
LOG_LEVEL=info
PROXY_VERBOSE_LOGS=false

###########################################################
# Email & Notifications                                    #
###########################################################
RESEND_API_KEY=your-resend-key
RESEND_FROM="Everything Assistant <hi@example.com>"
SMTP_EMAIL=hi@example.com
SMTP_USER=hi@example.com
SMTP_APP_PASSWORD=app-password

###########################################################
# External APIs & Media                                    #
###########################################################
GITHUB_TOKEN=ghp_example
GITHUB_REPO_OWNER=theg1239
GITHUB_REPO_NAME=the-everything-assistant
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456
CLOUDINARY_API_SECRET=abcdef

###########################################################
# Search, RAG & Automation Scripts                         #
###########################################################
BINARY_PATH=/usr/bin/chromium
CLI_TIMEOUT=60000
DRY_RUN=false
TARGET_SUBREDDITS=vit,chennai
MAX_POSTS_PER_SUBREDDIT=50
MAX_PAGES_PER_SUBREDDIT=5
MIN_UPVOTES_THRESHOLD=5
ENABLE_INITIAL_SCRAPE=true
SCRAPE_INTERVAL_HOURS=1
DEBUG_SCRAPERS=false
DEBUG_PAPERS_CODECHEF=false
SIMILARITY_THRESHOLD=0.75
TRUNCATE_BEFORE_IMPORT=false
PAPER_AGENT_STORE_PDF=true
PAPER_AGENT_DEBUG=false
PAPER_AGENT_USE_SYSTEM_BROWSER=false
PAPER_AGENT_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PAPERS_SERVICE_URL=http://localhost:4003
REDDIT_API_URL=https://www.reddit.com

###########################################################
# Proxy, VTOP & Campus Integrations                        #
###########################################################
VTOP_PROXY_URL=http://localhost:3001
VTOP_USERNAME=vit-username
VTOP_PASSWORD=vit-password
VTOP_RATE_LIMIT=30
VTOP_USER_LIMIT=5
VTOP_USER_WINDOW_MS=60000

###########################################################
# MCP / OAuth Broker                                       #
###########################################################
MCP_URL=http://localhost:8787
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER_URL=http://localhost:8787/oauth
MCP_OAUTH_RESOURCE_SERVER_URL=http://localhost:8787/resource
MCP_OAUTH_SERVICE_DOCS_URL=http://localhost:8787/docs
MCP_OAUTH_CLIENTS_PATH=./services/proxy-service/clients.json
MCP_OAUTH_STATIC_CLIENTS=[]
MCP_OAUTH_ACCESS_TOKEN_TTL=900
MCP_OAUTH_REFRESH_TOKEN_TTL=604800
MCP_OAUTH_CODE_TTL=300
MCP_OAUTH_CONSENT_TTL=300
MCP_OAUTH_CONSENT_SECRET=super-secret
MCP_OAUTH_DEFAULT_CLIENT_ID=local-client
MCP_OAUTH_DEFAULT_REDIRECT_URI=http://localhost:3000/api/callback
MCP_OAUTH_AUTO_REGISTER=true
MCP_OAUTH_STRICT_RESOURCE=true

###########################################################
# Messaging Bots & Channels                                #
###########################################################
WHATSAPP_BOT_API_KEY=your-wa-api-key
WHATSAPP_SESSION_PATH=./services/wa-bot/session
WHATSAPP_PUPPETEER_ARGS=--no-sandbox
DISCORD_TOKEN=discord-bot-token

###########################################################
# Testing & Continuous Integration                         #
###########################################################
PLAYWRIGHT=1
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
CI=false
CI_PLAYWRIGHT=false
TEST_USER_ID=test-user-uuid
