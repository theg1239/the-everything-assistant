/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com https://*.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.posthog.com; media-src 'self' blob: https:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/onboarding-artwork/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=2592000

/icons/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=2592000

/assets/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=2592000

/og-image.jpg
  Cache-Control: public,max-age=604800,stale-while-revalidate=2592000
