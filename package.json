{
  "name": "the-everything-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build && tsx scripts/sync-rag-vercel.ts",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed:rag": "tsx scripts/seed-rag.ts",
    "seed:rag-fresh": "tsx scripts/seed-rag.ts --fresh",
    "prisma:studio": "prisma studio",
    "test:performance": "tsx scripts/test-performance.ts",
    "test:performance:basic": "tsx scripts/test-performance.ts basic",
    "test:performance:advanced": "tsx scripts/test-performance.ts advanced",
    "test:performance:benchmark": "tsx scripts/test-performance.ts benchmark",
    "test:performance:stress": "tsx scripts/test-performance.ts stress",
    "test:performance:report": "tsx scripts/test-performance.ts report",
    "test:performance:seed": "tsx scripts/test-performance.ts seed",
    "papers:index": "tsx scripts/papers.ts",
    "preview": "opennextjs-cloudflare build && tsx scripts/minify-handler.ts && opennextjs-cloudflare preview",
    "deploy": "npx prisma generate && opennextjs-cloudflare build && tsx scripts/minify-handler.ts && opennextjs-cloudflare deploy -- --minify",
    "upload": "opennextjs-cloudflare build && tsx scripts/minify-handler.ts && opennextjs-cloudflare upload -- --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
