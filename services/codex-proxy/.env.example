# Bun server
CODEX_PROXY_PORT=8788
# Default 127.0.0.1. Use 0.0.0.0 only when the app reaches the proxy over the network (behind TLS).
CODEX_PROXY_HOST=127.0.0.1

# ChatGPT login mode: device (recommended for VM/serverless) or browser
CODEX_PROXY_CHATGPT_LOGIN_MODE=device
# OpenAI auth service overrides
CODEX_OPENAI_ISSUER=https://auth.openai.com
CODEX_CHATGPT_CLIENT_ID=
CODEX_PROXY_OPENAI_REQUEST_TIMEOUT_MS=20000
CODEX_PROXY_DEVICE_AUTH_TIMEOUT_MS=900000
CODEX_PROXY_EXTERNAL_REFRESH_LEEWAY_MS=60000

# Required shared secret expected from your app server (Bearer token). The proxy refuses to start
# without it: it authorises acting on behalf of any userId. Generate with `openssl rand -hex 32`.
CODEX_PROXY_AUTH_TOKEN=replace-with-long-random-token
# Local development only (ignored when NODE_ENV=production): start without a token.
# CODEX_PROXY_INSECURE_DEV=1

# Codex binary + app-server runtime
CODEX_BIN=codex
# Safety note: proxy strips unsafe execution flags and overrides of locked keys (features.*,
# web_search, sandbox, approval policy, ...) from CODEX_FLAGS/CODEX_APP_SERVER_FLAGS.
CODEX_FLAGS=
CODEX_FLAGS_JSON=
CODEX_APP_SERVER_FLAGS=
CODEX_APP_SERVER_FLAGS_JSON=
# Per-user CODEX_HOME dirs (0700) live under this root; each thread runs in <home>/workspace.
CODEX_APP_SERVER_HOME_ROOT=
CODEX_APP_SERVER_STARTUP_TIMEOUT_MS=15000
CODEX_APP_SERVER_REQUEST_TIMEOUT_MS=45000
CODEX_APP_SERVER_TURN_TIMEOUT_MS=180000
CODEX_APP_SERVER_MODEL=

# Session eviction
CODEX_PROXY_SESSION_IDLE_MS=1800000
CODEX_PROXY_SESSION_SWEEP_MS=300000
CODEX_PROXY_RUN_RETENTION_MS=600000
