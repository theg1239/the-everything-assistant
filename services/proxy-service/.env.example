NODE_ENV=production
PORT=3001

ALLOWED_ORIGINS=https://everything-assistant.com,http://localhost:3000

# ---- Authentication (required) -------------------------------------------------------------
# Shared secret the Next app / bots send as `Authorization: Bearer <key>` (or `X-Proxy-Key`).
# Without it every VTOP endpoint answers 503 (fail closed). /health stays public.
PROXY_API_KEY=replace-with-strong-random
# Local development only (ignored when NODE_ENV=production):
# PROXY_AUTH_DISABLED=true

# Encrypts workflow continuation tokens and signs download links. Must be identical on every
# instance; if unset a random per-process secret is used (tokens/links die on restart).
PROXY_TOKEN_SECRET=replace-with-strong-random
# Absolute base URL used in download links (otherwise derived from the request Host header)
PROXY_PUBLIC_URL=https://your-proxy.example.com
# Set when running behind a reverse proxy so req.protocol/IPs are correct (express "trust proxy")
# TRUST_PROXY=1

# ---- cli-top --------------------------------------------------------------------------------
# Path to the cli-top executable (defaults to ./binary, or ./binary.exe on Windows)
# BINARY_PATH=/usr/local/bin/cli-top
CLI_TIMEOUT=120000
CLI_DOWNLOAD_TIMEOUT=300000
# CLI_RUN_DIR=/tmp/vtop-proxy-runs
# CLI_RETRY_ATTEMPTS=1                 # automatic retries for transient VTOP/captcha failures (reads only)
# CLI_TOP_LATEST_JSON_CACHE=true       # serve cli-top's kill-switch document to children from memory
# CLI_TOP_LATEST_JSON_REFRESH_MS=300000
# CLI_ENV_PASSTHROUGH=                 # extra env var names to pass to cli-top (comma separated)

# ---- Throughput -----------------------------------------------------------------------------
# CLI_MAX_CONCURRENCY=8                # global cli-top processes (default max(4, 2 x CPUs))
# CLI_PER_USER_CONCURRENCY=1           # VTOP sessions per student at a time
# CLI_MAX_QUEUE=200
# CLI_PER_USER_MAX_QUEUE=8
# CLI_QUEUE_TIMEOUT_MS=60000
# RESULT_CACHE_ENABLED=true            # per-user TTL cache for read-only commands (TTL per command in hub-capabilities.json)
# RESULT_CACHE_MAX_ENTRIES=5000

# ---- Downloads ------------------------------------------------------------------------------
# FILE_STORE_DIR=/tmp/vtop-proxy-files
# FILE_TTL_SECONDS=3600
# FILE_STORE_MAX_BYTES=2147483648
# WORKFLOW_TOKEN_TTL_SECONDS=900

# ---- Abuse limits ---------------------------------------------------------------------------
GLOBAL_RATE_LIMIT=120
VTOP_RATE_LIMIT=30
# Per-username cap on actual cli-top runs (cache hits are free)
VTOP_USER_LIMIT=15
VTOP_USER_WINDOW_MS=300000
# VTOP_USERNAME_PATTERN=^[0-9]{2}[A-Za-z]{2,4}[0-9]{3,5}$

# ---- MCP OAuth (/mcp) -----------------------------------------------------------------------
MCP_OAUTH_ENABLED=true
MCP_OAUTH_ISSUER_URL=https://your-domain.com
MCP_OAUTH_RESOURCE_SERVER_URL=https://your-domain.com/mcp
MCP_OAUTH_SERVICE_DOCS_URL=https://docs.your-domain.com/proxy
MCP_OAUTH_ACCESS_TOKEN_TTL=3600
MCP_OAUTH_REFRESH_TOKEN_TTL=1209600
MCP_OAUTH_CODE_TTL=300
MCP_OAUTH_CONSENT_TTL=300
MCP_OAUTH_STRICT_RESOURCE=true
# REQUIRED when MCP OAuth is enabled (>= 16 chars); the proxy refuses to start without it.
MCP_OAUTH_CONSENT_SECRET=replace-with-strong-random
MCP_OAUTH_CLIENTS_PATH=./mcp-oauth-clients.json
MCP_OAUTH_STATIC_CLIENTS=[]
# Auto-registering unknown client_ids during /authorize is OFF by default. Enabling it also
# requires an allow-list of redirect hosts (host, *.suffix, custom-scheme:, http://localhost).
MCP_OAUTH_AUTO_REGISTER=false
# MCP_OAUTH_REDIRECT_ALLOWLIST=chatgpt.com,*.claude.ai,http://localhost
MCP_OAUTH_DEFAULT_CLIENT_ID=
MCP_OAUTH_DEFAULT_REDIRECT_URI=
